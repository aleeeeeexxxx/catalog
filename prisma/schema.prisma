// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["catalog", "stage"]

  relationMode = "prisma"
}

model System {
  id       String @id @db.VarChar(32)
  tenantId String @db.VarChar(32) // RLS

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  type             String @db.VarChar(256)
  uniqueIdentifier String @db.VarChar(256)

  // Prisma does not support partial unique index
  // manually [add] WHERE "deletedAt" IS NULL
  @@unique([tenantId, uniqueIdentifier])
  @@schema("catalog")
}

model Resource {
  id       String @id @db.VarChar(32)
  tenantId String @db.VarChar(32) // RLS

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  version String @db.VarChar(256)

  nativeUniqueName String @db.VarChar(256)
  name             String @db.VarChar(256)
  desc             String

  systemId String

  // Prisma does not support partial unique index
  // manually [add] WHERE "deletedAt" IS NULL
  @@unique([tenantId, systemId, nativeUniqueName])
  @@schema("catalog")
}

model Stage {
  id String @id @db.VarChar(32)

  stageAt DateTime @default(now())

  tenantId         String @db.VarChar(32)
  systemId         String @db.VarChar(32)
  nativeUniqueName String @db.VarChar(256)
  version          String @db.VarChar(256)

  @@schema("stage")
}

model StagedResource {
  stageId String @id @db.VarChar(32)

  name String @db.VarChar(256)
  desc String

  @@schema("stage")
}
