// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["catalog", "stage"]

  relationMode = "prisma"
}

model System {
  id String @id @db.VarChar(32)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  tenantId         String @db.VarChar(32) // RLS
  type             String @db.VarChar(256)
  uniqueIdentifier String @db.VarChar(256)

  // Prisma does not support partial unique index
  // manually [add] WHERE "deletedAt" IS NULL
  @@unique([tenantId, uniqueIdentifier])
  @@schema("catalog")
}

model Resource {
  id String @id @db.VarChar(32)

  createdAt DateTime  @default(now())
  createdBy String?   @db.VarChar(256)
  deletedAt DateTime?
  deletedBy String?   @db.VarChar(256)

  systemId         String
  tenantId         String @db.VarChar(32)
  nativeUniqueName String @db.VarChar(256)
  version          Int    @default(0)

  metadata String

  // Prisma does not support partial unique index
  // manually [add] WHERE "deletedAt" IS NULL
  @@unique([tenantId, systemId, nativeUniqueName])
  @@schema("catalog")
}

model ResourceRelationship {
  sourceId String @db.VarChar(32)
  targetId String @db.VarChar(32)
  type     String @db.VarChar(256)

  @@id([sourceId, targetId])
  @@schema("catalog")
}

model StageResource {
  stageId String @db.VarChar(32)
  id      String @db.VarChar(32)

  stageAt       DateTime  @default(now())
  startIngestAt DateTime?
  deletedBy     String?

  tenantId String @db.VarChar(32)

  nativeUniqueName String @db.VarChar(256)
  version          Int    @default(0)

  systemType         String @db.VarChar(256)
  systemTypeUniqueId String @db.VarChar(256)

  metadata String

  @@id([stageId, id])
  @@schema("stage")
}

model StagedRelationship {
  stageId String @db.VarChar(32)

  tenantId String @db.VarChar(32)

  sourceStageId String @db.VarChar(32)
  targetStageId String @db.VarChar(32)
  type          String @db.VarChar(256)

  @@id([stageId, sourceStageId, targetStageId, type])
  @@schema("stage")
}

model StagedSystem {
  stageId         String @db.VarChar(32)
  stageResourceId String @id

  tenantId         String @db.VarChar(32)
  type             String @db.VarChar(256)
  uniqueIdentifier String @db.VarChar(256)

  @@schema("stage")
}
